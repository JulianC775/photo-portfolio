# Copy to .env.local and fill in. Never commit .env.local.
# Values marked [M3] are not read by any code yet — they land with that milestone.
#
# The storage and revalidate vars are live as of M1, but nothing reads them until a page or the
# CLI actually needs storage: they are validated on first use, not at startup, so the site builds
# and runs with them blank (About and the home shell don't touch storage).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Locally use http://localhost:3000. On Vercel set this per
# environment so preview deploys don't advertise the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# [M1] Object storage — Garage/MinIO on the Pi, reached through the Cloudflare Tunnel.
# S3-compatible, so these same names work unchanged against R2 or S3 if the
# backend ever moves (docs/PLAN.md D3).
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=https://media.catellolens.com
STORAGE_REGION=garage
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Garage and MinIO address buckets by path, not by subdomain. Leave true for both.
STORAGE_FORCE_PATH_STYLE=true

STORAGE_BUCKET_PUBLIC=portfolio-public
STORAGE_BUCKET_PRIVATE=portfolio-private

# Public base URL for browser-facing media. Serves the public bucket through the
# tunnel, edge-cached by Cloudflare.
NEXT_PUBLIC_MEDIA_URL=https://media.catellolens.com/portfolio-public

# ---------------------------------------------------------------------------
# [M1] Cache revalidation — the upload CLI calls /api/revalidate with this secret
# so new photos appear within seconds instead of waiting out the ISR window.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# [M1] Upload CLI (local machine only — not set on Vercel)
# ---------------------------------------------------------------------------
# Where the CLI mirrors each manifest after writing it. This is the only data on
# the Pi that cannot be regenerated from the originals on your PC, so point this
# somewhere inside your normal backup scope. See CLAUDE.md invariant 7.
LOCAL_MANIFEST_MIRROR=

# ---------------------------------------------------------------------------
# [M3] Friends section auth
# ---------------------------------------------------------------------------
# scrypt hash of the shared password — not the password itself, so the plaintext
# never sits readable in the Vercel dashboard. Generated by a script in M3.
FRIENDS_PASSWORD_HASH=
# Signing key for the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
