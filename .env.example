# Copy to .env.local and fill in. Never commit .env.local.
# Values marked [M3] are not read by any code yet — they land with that milestone.
#
# The storage and revalidate vars are live as of M1, but nothing reads them until a page or the
# CLI actually needs storage: they are validated on first use, not at startup, so the site builds
# and runs with them blank (About and the home shell don't touch storage).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Locally use http://localhost:3000. On Vercel set this per
# environment so preview deploys don't advertise the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# [M1] Object storage — Garage/MinIO on the Pi, reached through the Cloudflare Tunnel.
# S3-compatible, so these same names work unchanged against R2 or S3 if the
# backend ever moves (docs/PLAN.md D3).
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=https://media.catellolens.com
STORAGE_REGION=garage
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Garage and MinIO address buckets by path, not by subdomain. Leave true for both.
STORAGE_FORCE_PATH_STYLE=true

STORAGE_BUCKET_PUBLIC=portfolio-public
STORAGE_BUCKET_PRIVATE=portfolio-private

# ---------------------------------------------------------------------------
# Private bucket on Cloudflare R2 (docs/PLAN.md D3, hybrid). Optional: leave
# PRIVATE_STORAGE_ENDPOINT blank and the private bucket uses the STORAGE_* connection above.
# Set, and originals + zips are served from R2 — free egress, fast from anywhere — instead of
# squeezing out through the house's upload line. Same bucket name as STORAGE_BUCKET_PRIVATE.
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; region is literally "auto".
# ---------------------------------------------------------------------------
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_REGION=auto
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=
PRIVATE_STORAGE_FORCE_PATH_STYLE=true
# Size ceiling the upload CLI enforces on the private bucket, in GB. Defaults to 9.5
# (under R2's 10 GB free tier) when PRIVATE_STORAGE_ENDPOINT is set, unlimited otherwise.
# The CLI refuses an upload that would pass it; `npm run remove-event` frees room.
# PRIVATE_STORAGE_CAP_GB=9.5

# Public base URL for browser-facing media. Serves the public bucket through the
# tunnel, edge-cached by Cloudflare. Defaults to this production value in code, so
# it does NOT need to be set on Vercel (which refuses NEXT_PUBLIC_ names as sensitive).
#
# Until the Pi exists, point this at the local seed server instead:
#   NEXT_PUBLIC_MEDIA_URL=http://localhost:4321
# then `npm run seed` once and `npm run dev:media` alongside `npm run dev`.
NEXT_PUBLIC_MEDIA_URL=https://media.catellolens.com/portfolio-public

# ---------------------------------------------------------------------------
# [M1] Cache revalidation — the upload CLI calls /api/revalidate with this secret
# so new photos appear within seconds instead of waiting out the ISR window.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# [M1] Upload CLI (local machine only — not set on Vercel)
# ---------------------------------------------------------------------------
# Where the CLI mirrors each manifest after writing it. This is the only data on
# the Pi that cannot be regenerated from the originals on your PC, so point this
# somewhere inside your normal backup scope. See CLAUDE.md invariant 7.
LOCAL_MANIFEST_MIRROR=

# ---------------------------------------------------------------------------
# [M3] Friends section auth
# ---------------------------------------------------------------------------
# OPTIONAL master password for the owner: signs into every event. Friends' per-event
# passwords don't live here — they go in the gitignored friends-passwords.json at the
# repo root and are pushed to the Pi with `npm run passwords`. This is the scrypt hash,
# not the password itself: generate with `npm run hash-password`.
FRIENDS_PASSWORD_HASH=
# Signing key for the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
